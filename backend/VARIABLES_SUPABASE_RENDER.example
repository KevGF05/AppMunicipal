# NO coloque secretos reales en este archivo ni lo suba con valores reales.
# Estas variables se crearán en Render > Environment.

SPRING_PROFILES_ACTIVE=supabase

APP_ADMIN_EMAIL=admin@municipalidad.hn
APP_ADMIN_PASSWORD=CAMBIAR_EN_RENDER
APP_TECNICO1_PASSWORD=CAMBIAR_EN_RENDER

SUPABASE_DB_HOST=aws-0-REGION.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.PROJECT_REF
SUPABASE_DB_PASSWORD=CAMBIAR_EN_RENDER

SUPABASE_S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=REGION
SUPABASE_S3_ACCESS_KEY=CAMBIAR_EN_RENDER
SUPABASE_S3_SECRET_KEY=CAMBIAR_EN_RENDER
SUPABASE_STORAGE_BUCKET=evidencias
SUPABASE_SIGNED_URL_MINUTES=15
