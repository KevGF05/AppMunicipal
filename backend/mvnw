#!/usr/bin/env sh
set -e
DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
MAVEN_VERSION=3.9.9
MAVEN_HOME="$DIR/.tools/apache-maven-$MAVEN_VERSION"
ZIP="$DIR/.tools/apache-maven-$MAVEN_VERSION-bin.zip"
if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  mkdir -p "$DIR/.tools"
  URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.zip"
  if command -v curl >/dev/null 2>&1; then curl -L "$URL" -o "$ZIP"; else wget "$URL" -O "$ZIP"; fi
  unzip -q -o "$ZIP" -d "$DIR/.tools"
fi
exec "$MAVEN_HOME/bin/mvn" "$@"
