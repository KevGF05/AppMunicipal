#!/usr/bin/env sh
set -e
DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
VERSION=8.9
HOME_DIR="$DIR/.tools/gradle-$VERSION"
ZIP="$DIR/.tools/gradle-$VERSION-bin.zip"
if [ ! -x "$HOME_DIR/bin/gradle" ]; then
  mkdir -p "$DIR/.tools"
  URL="https://services.gradle.org/distributions/gradle-$VERSION-bin.zip"
  if command -v curl >/dev/null 2>&1; then curl -L "$URL" -o "$ZIP"; else wget "$URL" -O "$ZIP"; fi
  unzip -q -o "$ZIP" -d "$DIR/.tools"
fi
exec "$HOME_DIR/bin/gradle" "$@"
