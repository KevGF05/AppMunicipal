<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AppMunicipal" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Colores principales de la Municipalidad -->
        <item name="colorPrimary">@color/municipal_green</item>
        <item name="colorSecondary">@color/municipal_yellow</item>

        <!-- Fondo y superficies -->
        <item name="android:colorBackground">@color/surface_translucent</item>

        <!-- Barras del sistema -->
        <item name="android:statusBarColor">@color/municipal_green</item>
        <item name="android:navigationBarColor">@color/surface_translucent</item>

        <!-- Texto / apariencia -->
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>

        <!-- Permitir Dark Mode -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">true</item>

    </style>

</resources>