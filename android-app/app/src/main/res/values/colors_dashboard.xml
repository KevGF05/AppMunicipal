<?xml version="1.0" encoding="utf-8"?>
<!--
  Antes existian dos paletas paralelas con los mismos valores (municipal_* y dashboard_*).
  Ahora dashboard_* son alias de la paleta unica: se conservan los nombres para no tener
  que tocar cada layout, pero el color real vive en colors.xml.
-->
<resources>
    <color name="dashboard_green">@color/municipal_green</color>
    <color name="dashboard_green_soft">@color/municipal_green_soft</color>
    <color name="dashboard_yellow">@color/municipal_yellow</color>
    <color name="dashboard_yellow_soft">@color/municipal_yellow_soft</color>
    <color name="dashboard_background">@color/municipal_background</color>
    <color name="dashboard_surface">@color/municipal_surface</color>
    <color name="dashboard_text">@color/municipal_text</color>
    <color name="dashboard_muted">@color/municipal_muted</color>
    <color name="dashboard_border">@color/municipal_border</color>
    <color name="dashboard_button_dark_text">#1F2937</color>
</resources>
