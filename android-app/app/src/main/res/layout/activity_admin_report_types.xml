<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_background"
    android:orientation="vertical">

    <!-- Encabezado fijo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dashboard_background"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonVolver"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="← Dashboard"
            android:textColor="@color/dashboard_green"
            app:backgroundTint="@color/dashboard_green_soft" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tipos de reporte"
            android:textColor="@color/dashboard_text"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Administre las categorías disponibles para los reportes ciudadanos y de patrullaje."
            android:textColor="@color/dashboard_muted"
            android:textSize="14sp" />

        <View
            android:layout_width="58dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:background="@color/dashboard_yellow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonVerDesactivados"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:text="Ver reportes desactivados"
            android:textColor="@color/dashboard_button_dark_text"
            app:backgroundTint="@color/dashboard_yellow"
            app:strokeColor="@color/dashboard_yellow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAgregarTipo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Agregar tipo de reporte"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:backgroundTint="@color/dashboard_green" />

        <TextView
            android:id="@+id/textSeccionTipos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Reportes disponibles"
            android:textColor="@color/dashboard_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textCantidadTipos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Cargando tipos..."
            android:textColor="@color/dashboard_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressTipos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textTiposVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="Todavía no hay tipos de reporte disponibles."
        android:textColor="@color/dashboard_muted"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTiposReporte"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="20dp" />
</LinearLayout>
