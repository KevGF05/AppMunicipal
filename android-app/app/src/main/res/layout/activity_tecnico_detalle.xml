<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonVolver"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="← Mis tickets"
            android:textColor="@color/dashboard_green"
            app:backgroundTint="@color/dashboard_green_soft" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/dashboard_surface"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/dashboard_border"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:id="@+id/textCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/dashboard_green"
                    android:textSize="23sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/textTipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/dashboard_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/textEstado"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/dashboard_text"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/textPrioridad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dashboard_muted" />
                </LinearLayout>
                <TextView
                    android:id="@+id/textDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/dashboard_text"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/textDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/dashboard_text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <ProgressBar
            android:id="@+id/progressDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imageInicial"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/evidence_background"
            android:contentDescription="Fotografía del reporte"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/layoutPausaActual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/dashboard_yellow_soft"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trabajo en pausa"
                android:textColor="@color/dashboard_text"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/textMotivoPausa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/dashboard_text" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonIniciar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:text="Iniciar trabajo"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/dashboard_green" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPausar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Pausar trabajo"
            android:textColor="@color/dashboard_button_dark_text"
            android:visibility="gone"
            app:backgroundTint="@color/dashboard_yellow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonReanudar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Reanudar trabajo"
            android:textColor="@android:color/white"
            android:visibility="gone"
            app:backgroundTint="@color/dashboard_green" />

        <LinearLayout
            android:id="@+id/layoutCierre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cerrar ticket"
                android:textColor="@color/dashboard_text"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Adjunte una fotografía de la reparación terminada."
                android:textColor="@color/dashboard_muted" />
            <ImageView
                android:id="@+id/imageFinal"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/evidence_background"
                android:contentDescription="Fotografía final"
                android:scaleType="centerCrop"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonFotoFinal"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="Tomar fotografía final"
                android:textColor="@color/dashboard_green"
                app:backgroundTint="@color/dashboard_green_soft"
                app:icon="@drawable/ic_camera_alt_24" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutComentarioCierre"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Comentario de cierre">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editComentario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="1000"
                    android:minLines="3"
                    android:textColor="@color/dashboard_text" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCerrarTicket"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:enabled="false"
                android:text="Cerrar ticket"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/dashboard_green" />
        </LinearLayout>

        <TextView
            android:id="@+id/textCierreExistente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/dashboard_green_soft"
            android:padding="14dp"
            android:textColor="@color/dashboard_text"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
