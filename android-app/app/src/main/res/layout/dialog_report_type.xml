<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/espacio_pantalla"
    android:paddingTop="@dimen/espacio_chico"
    android:paddingEnd="@dimen/espacio_pantalla"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/textAyudaTipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tipos_ayuda"
        android:textAppearance="@style/TextAppearance.AppMunicipal.Apoyo" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutNombreTipo"
        style="@style/Widget.AppMunicipal.Campo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/tipos_nombre">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editNombreTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="80"
            android:maxLines="2"
            android:textColor="@color/municipal_text" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
