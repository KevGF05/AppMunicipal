<?xml version="1.0" encoding="utf-8"?>
<!--
  El codigo de seguimiento es el unico vinculo del ciudadano con su reporte.
  Por eso ahora la pantalla ofrece copiarlo y compartirlo, y avisa que quedo
  guardado en Mis reportes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/municipal_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:title="@string/confirmacion_titulo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_grande">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/confirmacion_subtitulo"
                android:textAppearance="@style/TextAppearance.AppMunicipal.Cuerpo" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_pantalla"
                app:strokeColor="@color/municipal_green">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/confirmacion_label_codigo"
                        android:textAppearance="@style/TextAppearance.AppMunicipal.Etiqueta" />

                    <TextView
                        android:id="@+id/textCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:letterSpacing="0.08"
                        android:textColor="@color/municipal_green"
                        android:textIsSelectable="true"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCopiar"
                            style="@style/Widget.AppMunicipal.Boton.Secundario"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/alto_boton"
                            android:layout_weight="1"
                            android:text="@string/accion_copiar"
                            app:icon="@drawable/ic_content_copy_24" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCompartir"
                            style="@style/Widget.AppMunicipal.Boton.Secundario"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/alto_boton"
                            android:layout_marginStart="@dimen/espacio_chico"
                            android:layout_weight="1"
                            android:text="@string/accion_compartir"
                            app:icon="@drawable/ic_share_24" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/confirmacion_label_estado"
                        android:textAppearance="@style/TextAppearance.AppMunicipal.Etiqueta" />

                    <TextView
                        android:id="@+id/textEstado"
                        style="@style/Widget.AppMunicipal.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/confirmacion_guardado"
                android:textAppearance="@style/TextAppearance.AppMunicipal.Apoyo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonConsultar"
                style="@style/Widget.AppMunicipal.Boton.Primario"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="@dimen/espacio_grande"
                android:text="@string/confirmacion_consultar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonInicio"
                style="@style/Widget.AppMunicipal.Boton.Contorno"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="@string/confirmacion_inicio" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
