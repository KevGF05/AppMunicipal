<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/municipal_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back_24" />

    <!-- El indicador de carga queda fijo bajo la barra, no dentro del scroll,
         para que el contenido no salte cada vez que se recarga. -->
    <ProgressBar
        android:id="@+id/progressDetalle"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/espacio_medio"
            android:paddingTop="@dimen/espacio_medio"
            android:paddingEnd="@dimen/espacio_medio"
            android:paddingBottom="@dimen/espacio_grande">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/textCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.05"
                        android:textColor="@color/municipal_green"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textTipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.AppMunicipal.Seccion"
                        android:textSize="19sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textEstado"
                            style="@style/Widget.AppMunicipal.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/textPrioridad"
                            style="@style/Widget.AppMunicipal.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/espacio_chico" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_medio">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/detalle_ubicacion"
                        android:textAppearance="@style/TextAppearance.AppMunicipal.Etiqueta" />

                    <TextView
                        android:id="@+id/textDireccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.AppMunicipal.Cuerpo"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textCoordenadas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.AppMunicipal.Apoyo" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_medio"
                        android:text="@string/detalle_descripcion"
                        android:textAppearance="@style/TextAppearance.AppMunicipal.Etiqueta" />

                    <TextView
                        android:id="@+id/textDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.AppMunicipal.Cuerpo" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_medio"
                        android:text="@string/detalle_tecnico"
                        android:textAppearance="@style/TextAppearance.AppMunicipal.Etiqueta" />

                    <TextView
                        android:id="@+id/textTecnico"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.AppMunicipal.Cuerpo"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textObservacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAppearance="@style/TextAppearance.AppMunicipal.Apoyo" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/detalle_foto_inicial"
                android:textAppearance="@style/TextAppearance.AppMunicipal.Seccion" />

            <ImageView
                android:id="@+id/imageInicial"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/evidence_background"
                android:contentDescription="@string/cd_foto_inicial"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/labelFotoFinal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/detalle_foto_final"
                android:textAppearance="@style/TextAppearance.AppMunicipal.Seccion"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imageFinal"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/evidence_background"
                android:contentDescription="@string/cd_foto_final"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAcciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:visibility="gone"
                app:strokeColor="@color/municipal_green">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_medio">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/detalle_acciones"
                        android:textAppearance="@style/TextAppearance.AppMunicipal.Seccion"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/detalle_acciones_nota"
                        android:textAppearance="@style/TextAppearance.AppMunicipal.Apoyo" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonAprobar"
                        style="@style/Widget.AppMunicipal.Boton.Primario"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="14dp"
                        android:text="@string/admin_aprobar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonAsignar"
                        style="@style/Widget.AppMunicipal.Boton.Secundario"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/admin_asignar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonReasignar"
                        style="@style/Widget.AppMunicipal.Boton.Secundario"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/admin_reasignar"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRechazar"
                        style="@style/Widget.AppMunicipal.Boton.Atencion"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/admin_rechazar" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/detalle_historial"
                android:textAppearance="@style/TextAppearance.AppMunicipal.Seccion" />

            <TextView
                android:id="@+id/textHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.AppMunicipal.Cuerpo" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
