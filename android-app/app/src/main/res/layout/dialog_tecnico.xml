<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/espacio_pantalla"
        android:paddingTop="@dimen/espacio_chico"
        android:paddingEnd="@dimen/espacio_pantalla"
        android:paddingBottom="4dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNombreTecnico"
            style="@style/Widget.AppMunicipal.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/tecnicos_nombre">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editNombreTecnico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="60"
                android:maxLines="1"
                android:textColor="@color/municipal_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutApellidoTecnico"
            style="@style/Widget.AppMunicipal.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/tecnicos_apellido">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editApellidoTecnico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="80"
                android:maxLines="1"
                android:textColor="@color/municipal_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutTelefonoTecnico"
            style="@style/Widget.AppMunicipal.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/tecnicos_telefono">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTelefonoTecnico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:maxLength="30"
                android:maxLines="1"
                android:textColor="@color/municipal_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textCorreoGenerado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/tecnicos_correo_pendiente"
            android:textColor="@color/municipal_green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tecnicos_correo_nota"
            android:textAppearance="@style/TextAppearance.AppMunicipal.Apoyo" />

        <TextView
            android:id="@+id/textPasswordTecnico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tecnicos_password_nota"
            android:textAppearance="@style/TextAppearance.AppMunicipal.Apoyo" />
    </LinearLayout>
</ScrollView>
