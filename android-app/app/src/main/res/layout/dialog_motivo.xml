<?xml version="1.0" encoding="utf-8"?>
<!--
  Antes el campo de motivo (rechazo y pausa) se creaba en codigo con
  setPadding(48, 16, 48, 16) en pixeles crudos, asi que se veia distinto en cada
  densidad de pantalla. Ahora es un layout normal.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/espacio_pantalla"
    android:paddingTop="@dimen/espacio_chico"
    android:paddingEnd="@dimen/espacio_pantalla"
    android:paddingBottom="4dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutMotivo"
        style="@style/Widget.AppMunicipal.Campo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editMotivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:minLines="3"
            android:textColor="@color/municipal_text" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
