<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/espacio_pantalla"
    android:paddingTop="@dimen/espacio_chico"
    android:paddingEnd="@dimen/espacio_pantalla"
    android:paddingBottom="4dp">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.AppMunicipal.Campo.Lista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/admin_dialog_tecnico">

        <AutoCompleteTextView
            android:id="@+id/autoTecnico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/municipal_text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.AppMunicipal.Campo.Lista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/admin_dialog_prioridad">

        <AutoCompleteTextView
            android:id="@+id/autoPrioridad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/municipal_text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutObservacion"
        style="@style/Widget.AppMunicipal.Campo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/admin_dialog_observacion">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editObservacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:minLines="3"
            android:textColor="@color/municipal_text" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
