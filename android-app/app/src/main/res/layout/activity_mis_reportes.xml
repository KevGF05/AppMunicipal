<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla nueva. La base SQLite local ya guardaba todos los codigos enviados,
  pero solo se leia el ultimo. Aqui se muestran todos y se refrescan sus estados.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/municipal_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:subtitle="@string/mis_reportes_subtitulo"
        app:title="@string/mis_reportes_titulo" />

    <TextView
        android:id="@+id/textResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/espacio_pantalla"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/espacio_pantalla"
        android:paddingBottom="4dp"
        android:textAppearance="@style/TextAppearance.AppMunicipal.Apoyo" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMisReportes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/espacio_medio"
                android:paddingTop="@dimen/espacio_chico"
                android:paddingEnd="@dimen/espacio_medio"
                android:paddingBottom="@dimen/espacio_pantalla" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/layoutVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/cd_estado_vacio"
                android:src="@drawable/ic_estado_vacio_48" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_medio"
                android:gravity="center"
                android:text="@string/mis_reportes_vacio_titulo"
                android:textAppearance="@style/TextAppearance.AppMunicipal.Seccion" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/mis_reportes_vacio_detalle"
                android:textAppearance="@style/TextAppearance.AppMunicipal.Apoyo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCrearReporte"
                style="@style/Widget.AppMunicipal.Boton.Primario"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/alto_boton"
                android:layout_marginTop="@dimen/espacio_pantalla"
                android:text="@string/mis_reportes_crear" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
