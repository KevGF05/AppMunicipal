<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.AppMunicipal.Card.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/espacio_medio">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textCodigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:textColor="@color/municipal_green"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.AppMunicipal.Cuerpo" />

            <TextView
                android:id="@+id/textEstado"
                style="@style/Widget.AppMunicipal.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textFecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.AppMunicipal.Apoyo" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCopiarCodigo"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/alto_boton"
            android:layout_height="@dimen/alto_boton"
            android:contentDescription="@string/mis_reportes_copiar_descripcion"
            app:icon="@drawable/ic_content_copy_24"
            app:iconTint="@color/municipal_muted" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
