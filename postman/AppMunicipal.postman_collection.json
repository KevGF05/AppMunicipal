                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/tecnicos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "tecnicos"
              ]
            }
          }
        },
        {
          "name": "Asignar reporte",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"technicianId\": {{technicianId}},\n  \"priority\": \"ALTA\",\n  \"observation\": \"Atender en la demostración.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/reportes/{{reportId}}/asignar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "reportes",
                "{{reportId}}",
                "asignar"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Técnico",
