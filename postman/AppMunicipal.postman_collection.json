{
  "info": {
    "_postman_id": "63e30831-4e8e-4d2f-8e21-appmunicipal",
    "name": "App Municipal API",
    "description": "Colección para probar el flujo del sistema municipal. Cree primero un reporte desde Android o configure manualmente las variables reportId y trackingCode.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "technicianToken",
      "value": ""
    },
    {
      "key": "reportId",
      "value": "1"
    },
    {
      "key": "trackingCode",
      "value": "EP-2026-000001"
    },
    {
      "key": "technicianId",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "Público",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/public/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "public",
                "health"
              ]
            }
          }
        },
        {
          "name": "Crear reporte anónimo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('reportId', body.id);",
                  "pm.collectionVariables.set('trackingCode', body.code);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "tipo",
                  "value": "Señalización dañada",
                  "type": "text"
                },
                {
                  "key": "descripcion",
                  "value": "La señal está caída y bloquea parcialmente la acera.",
                  "type": "text"
                },
                {
                  "key": "direccion",
                  "value": "El Progreso, Yoro, Honduras",
                  "type": "text"
                },
                {
                  "key": "latitud",
                  "value": "15.4009",
                  "type": "text"
                },
                {
                  "key": "longitud",
                  "value": "-87.8000",
                  "type": "text"
                },
                {
                  "key": "foto",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/public/reportes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "public",
                "reportes"
              ]
            },
            "description": "Seleccione manualmente un archivo de imagen en el campo foto antes de enviar."
          }
        },
        {
          "name": "Consultar estado por código",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/public/reportes/{{trackingCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "public",
                "reportes",
                "{{trackingCode}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@municipalidad.hn\",\n  \"password\": \"Admin123*\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login técnico",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('technicianToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tecnico1@municipalidad.hn\",\n  \"password\": \"Tecnico123*\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Administrador",
      "item": [
        {
          "name": "Listar reportes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/reportes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "reportes"
              ]
            }
          }
        },
        {
          "name": "Aprobar reporte",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/reportes/{{reportId}}/aprobar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "reportes",
                "{{reportId}}",
                "aprobar"
              ]
            }
          }
        },
        {
          "name": "Listar técnicos",
          "request": {
            "method": "GET",
            "header": [
